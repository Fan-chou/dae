#!/bin/sh
# Plain-HTTP door for the panel alone, on its own port (default 2080), so a
# phone does not have to trust the router's CA just to open it. Its document
# root (/www/kdae-http) holds the panel and its proxy and nothing else, so LuCI
# is not served there and keeps redirecting to HTTPS on the main ports.
#
# Safe to run again. It leaves an existing instance alone, so a changed port
# stays changed; remove it with: uci delete uhttpd.kdae && uci commit uhttpd

set -eu

PORT=${KDAE_UI_HTTP_PORT:-2080}

uci -q get uhttpd.kdae >/dev/null && exit 0
uci -q batch <<EOF
set uhttpd.kdae=uhttpd
add_list uhttpd.kdae.listen_http='0.0.0.0:$PORT'
add_list uhttpd.kdae.listen_http='[::]:$PORT'
set uhttpd.kdae.home='/www/kdae-http'
set uhttpd.kdae.cgi_prefix='/cgi-bin'
set uhttpd.kdae.script_timeout='60'
set uhttpd.kdae.network_timeout='30'
set uhttpd.kdae.max_requests='3'
set uhttpd.kdae.http_keepalive='20'
set uhttpd.kdae.tcp_keepalive='1'
commit uhttpd
EOF
/etc/init.d/uhttpd reload >/dev/null 2>&1 || true
