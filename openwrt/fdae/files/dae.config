config dae 'config'
	option enabled '0'
	option config_file '/etc/dae/config.dae'
	option log_maxbackups '1'
	option log_maxsize '1'
	option lan_interface ''
	option wan_interface ''
	option admin_listen ''
	option admin_secret ''
	option tcp_sockmap '0'
	# option mihomo_config '/etc/dae/mihomo.yaml'
	# option mihomo_interval '1h'
	# option isolate_transport_groups 'YouTube,Netflix'
	# option geoip_url 'https://github.com/v2fly/geoip/releases/latest/download/geoip.dat'
	# option geosite_url 'https://github.com/v2fly/domain-list-community/releases/latest/download/dlc.dat'
	# option geodata_interval '168h'
	# list env 'GOMEMLIMIT=256MiB'

# The complete Mihomo YAML (routing, groups, nodes): role 'routing'. A
# subscription that only lists nodes: role 'nodes'. At most one 'routing'.
# config subscription
#	option tag 'main'
#	option url 'https://example.com/clash'
#	option role 'routing'

# Resolve a node's server name through a given DNS server.
# config mixin
#	option name 'node name as the subscription calls it'
#	option resolve_dns '8.8.8.8'
